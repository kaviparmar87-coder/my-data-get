# All secrets come from these env vars — no hardcoded values in code.
# Local: fill .env  |  Render: Dashboard → Environment

# --- Database (required) ---
DATABASE_HOST=offerzoneindia.com
DATABASE_NAME=offerric_top9deals
DATABASE_USER=offerric_apadmin
DATABASE_PASSWORD=your_db_password
DATABASE_PORT=3306

# --- OpenRouter (required) ---
OPENROUTER_API_KEY=sk-or-v1-...

# --- Site ---
SITE_URL=https://top9deals.com
ADMIN_KEY=top9deals-admin-2024

# --- Sync schedule ---
SYNC_INTERVAL_SECONDS=60
INGEST_ENABLED=true
PRICEHISTORY_API_URL=https://pricehistoryapp.com/api/deals
PRICEHISTORY_PAGE_SIZE=28
PRICEHISTORY_MAX_PAGES=1
PRICEHISTORY_MIN_DISCOUNT=0
PRICEHISTORY_HEADERS=

# --- SEO ---
SEO_ENABLED=true
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free,liquid/lfm-2.5-2.6b:free,recursive/flint-v1.0:free
SEO_BATCH_SIZE=5
SEO_CALL_DELAY_MS=800
SEO_INCLUDE_AGGREGATE_RATING=false

# --- Server ---
PORT=3000
